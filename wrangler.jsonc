{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "pitchkit",
  // Workers Builds non-prod is `npx wrangler versions upload` with an empty dashboard
  // build command. Generate the OpenNext worker before wrangler looks for main.
  "build": {
    "command": "npx opennextjs-cloudflare build",
  },
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pitchkit",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "HIDDEN_KIT",
      "id": "8a50f78eca5e4bf7bbabc96d9f9df63c",
    },
  ],
  // Neon via Hyperdrive — TODO: uncomment when Randy supplies ids.
  // Do not invent Hyperdrive ids. Empty id strings are invalid.
  // Prod: HYPERDRIVE. Preview: HYPERDRIVE_PREVIEW.
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<todo-hyperdrive-id>" },
  //   { "binding": "HYPERDRIVE_PREVIEW", "id": "<todo-hyperdrive-preview-id>" },
  // ],
  // Kit images — bucket name planned as pitchkit-media. Public read for kit objects.
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "pitchkit-media" },
  // ],
}
