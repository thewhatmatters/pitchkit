# Names only. Values are Workers secrets — never commit them.
# Instagram Login
IG_APP_ID=
IG_APP_SECRET=

# Encrypts Instagram tokens at rest. Rotate by re-encrypting.
# Not required for the in-repo /k/demo seed (tokens stay null).
TOKEN_KEY=

# Pin Graph. Bump on purpose; do not float "latest".
GRAPH_API_VERSION=v25.0

# Temporary operator dry-run: long-lived Instagram User token.
# Insights poll uses this for live (non-demo) rows with no encrypted token.
# Never applied to seed handle `demo` — that mixed live Graph into /k/demo.
# IG_USER_TOKEN=

# Must match the Meta App Dashboard exactly (trailing slash included if the
# dashboard added one). Default in production: https://pitchkit.app/auth/instagram
# IG_REDIRECT_URI=https://pitchkit.app/auth/instagram

# Supabase Postgres via Hyperdrive — bind in wrangler, do not put production URLs here.
# Prod Worker binding: HYPERDRIVE (env.HYPERDRIVE.connectionString)
# Preview Worker binding: HYPERDRIVE_PREVIEW
# Leave wrangler.jsonc hyperdrive ids commented until Randy supplies them.
# Hyperdrive origin = Supabase **direct** URI (port 5432), not the pooler (6543).
# Optional local Next / schema apply only (ignored inside node:test):
# HYPERDRIVE_LOCAL_CONNECTION_STRING=postgresql://USER:PASS@HOST:5432/postgres
# Apply db/*.sql once the direct URI exists:
#   HYPERDRIVE_LOCAL_CONNECTION_STRING='…' npm run db:apply
