# Names only. Values are Workers secrets — never commit them.
# Instagram Login
IG_APP_ID=
IG_APP_SECRET=

# Encrypts Instagram tokens at rest. Rotate by re-encrypting.
TOKEN_KEY=

# Pin Graph. Bump on purpose; do not float "latest".
GRAPH_API_VERSION=v25.0

# Neon via Hyperdrive — bind in wrangler, do not put production URLs here.
# Prod binding: HYPERDRIVE
# Preview binding: HYPERDRIVE_PREVIEW
# Optional local note only (not used by the scaffold yet):
# HYPERDRIVE_LOCAL_CONNECTION_STRING=
